# Env var template (just a guide, no program reads this file).
# Usage: copy it and rename it to .env (.env is not in git, it's already in .gitignore), change values as needed.
#        docker compose reads the .env in the same folder on startup and fills in the ${...} in docker-compose.yml.
# Only lists the vars that docker-compose.yml really uses and that you may need to change.

# GCP project ID: used when calling Gemini through Vertex AI. If not set, the default in docker-compose.yml is used
GCP_PROJECT=organic-victory-508017-v9

# Which LLM parses the preferences:
#   gemini = the real Gemini (needs ../secrets/llm-service-account.json outside the repo)
#   mock   = local keyword stand-in api/fake_llm.py (no key, costs nothing, but only knows keywords)
LLM_PROVIDER=gemini

# Not configured here:
#   GOOGLE_APPLICATION_CREDENTIALS defaults to /secrets/llm-service-account.json (API override below).
#   You just need to put the key file in the ../secrets/ folder outside the repo.

# ---- Data collection / scoring (docker-shell.sh in src/data-collector and src/data-labeler reads this file with --env-file) ----
# Name of the bucket that stores the data
GREENPATH_BUCKET=ac215-notebook
# Group project ID: used for calling Gemini 2.5 when scoring and for reading Secret Manager in the cloud
GOOGLE_CLOUD_PROJECT=organic-victory-508017-v9
GOOGLE_CLOUD_LOCATION=us-central1
# For downloading street view images (everyone gets one free from the Mapillary developer dashboard, don't commit it, don't post it in the group chat)
MAPILLARY_TOKEN=

# RAG uses Chroma over HTTP; its database persists in src/rag-service/docker-volumes/chromadb/.
RAG_GCP_PROJECT=extended-web-508017-j2
RAG_GCP_LOCATION=global
RAG_GENERATIVE_MODEL=gemini-3.1-flash-lite
RAG_GENERATOR=base
RAG_CHUNK_TYPE=markdown-split
# A remote persisted Chroma server can be configured without mounting data in the RAG API.
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_SSL=false
RAG_CLOUD_TIMEOUT_MS=20000
RAG_GATEWAY_TIMEOUT_SECONDS=50
# For running Next.js outside Docker:
# API_SERVICE_URL=http://localhost:9000

# Phase 3 API: real Boston region and private Model Service connection.
# Default area: city_ma_boston_big. No prediction results are persisted.
GREENPATH_DATASET=1026_Full_data
MODEL_SERVICE_URL=http://host.docker.internal:8080
MODEL_MAX_CONCURRENCY=10
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LOCATION=global
# Optional API ADC filename inside the existing ../secrets -> /secrets mount.
GOOGLE_APPLICATION_CREDENTIALS_CONTAINER=/secrets/llm-service-account.json
