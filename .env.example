# Copy to .env; never commit credentials.
GCP_PROJECT=organic-victory-508017-v9
GOOGLE_CLOUD_PROJECT=organic-victory-508017-v9
GCS_BUCKET=ac215-greenpath
SERVING_URI=gs://ac215-greenpath/artifacts/serving/boston-heldout-en-v2
# mock parses keywords offline. gemini uses host ADC via docker-compose.gcp.yml.
LLM_PROVIDER=mock
MODEL_PROVIDER=bundle
# Optional: after fetching an artifact into .artifacts/boston-heldout-en-v2
# MODEL_BUNDLE_DIR=/artifacts/boston-heldout-en-v2
# ADC_FILE=/absolute/path/to/application_default_credentials.json
# API_PORT=9001
# FRONTEND_PORT=3001
# Notebook and optional upstream acquisition credentials:
MAPILLARY_TOKEN=
GOOGLE_CLOUD_LOCATION=us-central1

# Four-job container pipeline (make run); only ingestion receives read-only ADC.
PIPELINE_SOURCE_URI=gs://ac215-greenpath/artifacts/snapshots/sources/boston-processed-v1
PIPELINE_ENCODER_URI=gs://ac215-greenpath/artifacts/encoders/clip-b16-laion2b-v1
PIPELINE_CPUS=4
PIPELINE_BATCH_SIZE=8
# App ports for make run default to 9000/3000; override via PIPELINE_ARGS.

# Optional upstream notebook 01-04 jobs (never called by make run).
# Keep tokens out of source JSON, images and Git. Reuse the credential variables above.
SOURCE_CONFIG=./configs/source-boston.example.json
SOURCE_DATA_DIR=./.artifacts/sources/boston-source-local-v1
# Positive integer image limit per explicit label-images invocation; retries may add calls.
SOURCE_MAX_IMAGES=8
# Select a newly published source snapshot without replacing historical inputs.
PIPELINE_SOURCE_VERSION=boston-processed-v1

# Serving version catalog is read from .artifacts/catalog/serving.json by the API.
# Use make catalog-refresh to register existing successful pipeline runs.
# New source-to-app configuration is selected by WORKFLOW_CONFIG in make run-all.
# The supplied 50-cell pilot workflow requires --allow-labeling for unfinished labels.
