# 环境变量模板（说明书，没有程序会读这个文件）。
# 用法：复制一份改名为 .env（.env 不进 git，已写在 .gitignore 里），按需改值。
#       docker compose 启动时会自动读同一文件夹里的 .env，替换 docker-compose.yml 里的 ${...}。
# 这里只列 docker-compose.yml 真正用到、你可能需要改的变量。

# GCP 项目 ID：走 Vertex AI 调 Gemini 时用。不写就用 docker-compose.yml 里的默认值
GCP_PROJECT=organic-victory-508017-v9

# 用哪个 LLM 解析偏好：
#   gemini = 真的 Gemini（需要仓库外面的 ../secrets/llm-service-account.json）
#   mock   = 本地关键词替身 api/fake_llm.py（不需要 key、不花钱，但只认关键词）
LLM_PROVIDER=gemini

# 不在这里配置的：
#   GOOGLE_APPLICATION_CREDENTIALS defaults to /secrets/llm-service-account.json (API override below).
#   你只需要把 key 文件放到仓库外面的 ../secrets/ 文件夹里。

# ---- 数据采集 / 打分（src/data-collector、src/data-labeler 的 docker-shell.sh 用 --env-file 读这个文件）----
# 存数据的 bucket 名
GREENPATH_BUCKET=ac215-notebook
# group project 的 ID：打分调 Gemini 2.5、云上读 Secret Manager 都用它
GOOGLE_CLOUD_PROJECT=organic-victory-508017-v9
GOOGLE_CLOUD_LOCATION=us-central1
# 下载街景用（每人在 Mapillary 开发者后台免费申请；不要提交、不要发群里）
MAPILLARY_TOKEN=

# RAG uses Chroma over HTTP; its database persists in src/rag-service/docker-volumes/chromadb/.
RAG_GCP_PROJECT=extended-web-508017-j2
RAG_GCP_LOCATION=global
RAG_GENERATIVE_MODEL=gemini-3.1-flash-lite
RAG_GENERATOR=base
RAG_CHUNK_TYPE=markdown-split
# A remote persisted Chroma server can be configured without mounting data in the RAG API.
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_SSL=false
RAG_CLOUD_TIMEOUT_MS=20000
RAG_GATEWAY_TIMEOUT_SECONDS=50
# For running Next.js outside Docker:
# API_SERVICE_URL=http://localhost:9000

# Phase 3 API: real Boston region and private Model Service connection.
# Default area: city_ma_boston_big. No prediction results are persisted.
GREENPATH_DATASET=1026_Full_data
MODEL_SERVICE_URL=http://host.docker.internal:8080
MODEL_MAX_CONCURRENCY=3
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LOCATION=global
# Optional API ADC filename inside the existing ../secrets -> /secrets mount.
GOOGLE_APPLICATION_CREDENTIALS_CONTAINER=/secrets/llm-service-account.json
